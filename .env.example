# ==================== Database ====================
# Local development: docker-compose.yml maps MySQL to host port 13306
# Docker container mode: docker-compose.yml overrides this automatically
DATABASE_URL="mysql://root:text_stoty_ai123@localhost:13306/text_stoty_ai"

# ==================== Storage ====================
# minio: S3 localizedStorage（default）
# local: localizedStorage（development only）
# cos: reserved provider（not implemented in this version）
STORAGE_TYPE=minio

# MinIO / S3 localizedStorageConfig
# Local development: docker-compose.yml maps MinIO to host port 19000
MINIO_ENDPOINT=http://localhost:19000
MINIO_REGION=us-east-1
MINIO_BUCKET=text_stoty_ai
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_FORCE_PATH_STYLE=true

# COS Config（reserved）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=

# ==================== Auth ====================
# Local development（option three）：use http://localhost:3000
# Docker container mode（options one and two）：injected by docker-compose.yml as http://localhost:13000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=please-change-this-to-a-random-string

# ==================== Internal app self-call URL ====================
# Only used by server-side internal fetches for this app API/files.
# Local developmentusually matches NEXTAUTH_URL；Docker localizedinjected by docker-compose.yml as http://127.0.0.1:3000
INTERNAL_APP_URL=http://127.0.0.1:3000

# ==================== Internal secrets ====================
CRON_SECRET=please-change-this-cron-secret
INTERNAL_TASK_TOKEN=please-change-this-task-token
API_ENCRYPTION_KEY=text_stoty_ai-opensource-fixed-key-2026

# ==================== Redis ====================
# Local development：docker-compose.yml maps Redis to host port 16379
# Docker container mode: docker-compose.yml overrides this automatically
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=

# ==================== Worker Config ====================
WATCHDOG_INTERVAL_MS=30000
TASK_HEARTBEAT_TIMEOUT_MS=90000
QUEUE_CONCURRENCY_IMAGE=50
QUEUE_CONCURRENCY_VIDEO=50
QUEUE_CONCURRENCY_VOICE=20
QUEUE_CONCURRENCY_TEXT=50

# ==================== Bull Board (task management board) ====================
BULL_BOARD_HOST=0.0.0.0
BULL_BOARD_PORT=3010
BULL_BOARD_BASE_PATH=/admin/queues
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# ==================== Logs ====================
LOG_UNIFIED_ENABLED=true
LOG_LEVEL=ERROR
LOG_FORMAT=json
LOG_DEBUG_ENABLED=false
LOG_AUDIT_ENABLED=true
LOG_SERVICE=text_stoty_ai
LOG_REDACT_KEYS=password,token,apiKey,apikey,authorization,cookie,secret,access_token,refresh_token

# ==================== Billing ====================
BILLING_MODE=OFF

# ==================== Streaming output ====================
LLM_STREAM_EPHEMERAL_ENABLED=true
